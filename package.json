{
	"name": "espc-spfx-session-demo",
	"version": "1.0.2",
	"private": true,
	"engines": {
		"node": ">=22.14.0 < 23.0.0"
	},
	"main": "lib/index.js",
	"scripts": {
		"build": "gulp bundle",
		"clean": "gulp clean",
		"serve": "gulp serve",
		"serve:proxy": "devproxy --config-file config/devproxy-spfx-config.json & gulp serve --nobrowser",
		"version:patch": "npm version patch --no-git-tag-version && gulp sync-version",
		"test": "jest --passWithNoTests",
		"test:e2e": "playwright test"
	},
	"jest": {
		"roots": [
			"<rootDir>/src"
		],
		"testMatch": [
			"**/?(*.)+(test).[jt]s?(x)"
		],
		"transform": {
			"^.+\\.(ts|tsx)$": "ts-jest"
		},
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		],
		"testEnvironment": "jsdom",
		"moduleNameMapper": {
			"^.+\\.(css|scss)$": "identity-obj-proxy",
			"^NewCustomerFormWebPartStrings$": "<rootDir>/__mocks__/NewCustomerFormWebPartStrings.js"
		}
	},
	"dependencies": {
		"@fluentui/react": "^8.106.4",
		"@microsoft/microsoft-graph-types": "^2.40.0",
		"@microsoft/sp-component-base": "1.21.1",
		"@microsoft/sp-core-library": "1.21.1",
		"@microsoft/sp-lodash-subset": "1.21.1",
		"@microsoft/sp-office-ui-fabric-core": "1.21.1",
		"@microsoft/sp-property-pane": "1.21.1",
		"@microsoft/sp-webpart-base": "1.21.1",
		"@pnp/graph": "^4.15.0",
		"@pnp/nodejs": "^4.15.0",
		"@pnp/sp": "^4.15.0",
		"@types/node": "^24.0.15",
		"gulp-util": "^3.0.8",
		"react": "17.0.1",
		"react-dom": "17.0.1",
		"tslib": "2.3.1"
	},
	"devDependencies": {
		"@microsoft/eslint-config-spfx": "1.21.1",
		"@microsoft/eslint-plugin-spfx": "1.21.1",
		"@microsoft/rush-stack-compiler-5.3": "0.1.0",
		"@microsoft/sp-build-web": "1.21.1",
		"@microsoft/sp-module-interfaces": "1.21.1",
		"@playwright/test": "^1.54.1",
		"@rushstack/eslint-config": "4.0.1",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^12.1.5",
		"@types/jest": "^30.0.0",
		"@types/react": "17.0.45",
		"@types/react-dom": "17.0.17",
		"@types/webpack-env": "~1.15.2",
		"ajv": "^6.12.5",
		"dotenv": "^17.2.0",
		"eslint": "8.57.1",
		"eslint-plugin-react-hooks": "4.3.0",
		"gulp": "4.0.2",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.0.4",
		"jest-environment-jsdom": "^30.0.4",
		"playwright": "^1.54.1",
		"ts-jest": "^29.4.0",
		"typescript": "~5.3.3"
	}
}
