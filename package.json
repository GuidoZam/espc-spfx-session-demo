{
	"name": "espc-spfx-session-demo",
	"version": "1.0.7",
	"private": true,
	"engines": {
		"node": ">=22.14.0 < 23.0.0"
	},
	"main": "lib/index.js",
	"scripts": {
		"build": "heft build --clean",
		"test": "heft test",
		"test-only": "heft run --only test --",
		"clean": "heft clean",
		"deploy": "heft dev-deploy",
		"start": "heft start --clean",
		"build-watch": "heft build --lite",
		"package-solution:test": "heft package-solution",
		"package-solution:prod": "heft package-solution --production",
		"deploy-azure-storage": "heft deploy-azure-storage",
		"eject-webpack": "heft eject-webpack",
		"trust-dev-cert": "heft trust-dev-cert",
		"untrust-dev-cert": "heft untrust-dev-cert",
		"version:patch": "npm version patch --no-git-tag-version",
		"test:unit": "jest --passWithNoTests",
		"test:e2e": "playwright test",
		"test:e2e:update-snapshots": "playwright test --update-snapshots && ./view-snapshots.sh && ./update-readme-visuals.sh && cat SNAPSHOT_REPORT.md",
		"start:devproxy": "devproxy --config-file ./config/devproxy-spfx-config.json & heft start --clean"
	},
	"jest": {
		"roots": [
			"<rootDir>/src"
		],
		"testMatch": [
			"**/?(*.)+(test).[jt]s?(x)"
		],
		"transform": {
			"^.+\\.(ts|tsx)$": "ts-jest"
		},
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		],
		"testEnvironment": "jsdom",
		"moduleNameMapper": {
			"^.+\\.(css|scss)$": "identity-obj-proxy",
			"^NewCustomerFormWebPartStrings$": "<rootDir>/__mocks__/NewCustomerFormWebPartStrings.js"
		}
	},
	"dependencies": {
		"@fluentui/react": "^8.106.4",
		"@microsoft/microsoft-graph-types": "^2.40.0",
		"@microsoft/sp-core-library": "1.22.0-beta.3",
		"@microsoft/sp-component-base": "1.22.0-beta.3",
		"@microsoft/sp-property-pane": "1.22.0-beta.3",
		"@microsoft/sp-webpart-base": "1.22.0-beta.3",
		"@microsoft/sp-lodash-subset": "1.22.0-beta.3",
		"@microsoft/sp-office-ui-fabric-core": "1.22.0-beta.3",
		"@pnp/graph": "^4.15.0",
		"@pnp/nodejs": "^4.15.0",
		"@pnp/sp": "^4.15.0",
		"@types/node": "^24.0.15",
		"react": "17.0.1",
		"react-dom": "17.0.1",
		"tslib": "2.3.1"
	},
	"devDependencies": {
		"@microsoft/eslint-plugin-spfx": "1.22.0-beta.3",
		"@microsoft/eslint-config-spfx": "1.22.0-beta.3",
		"@microsoft/spfx-web-build-rig": "1.22.0-beta.3",
		"@microsoft/spfx-heft-plugins": "1.22.0-beta.3",
		"@microsoft/rush-stack-compiler-5.3": "0.1.0",
		"@microsoft/sp-module-interfaces": "1.22.0-beta.3",
		"@rushstack/heft": "0.74.3",
		"@types/heft-jest": "1.0.2",
		"@playwright/test": "^1.54.1",
		"@rushstack/eslint-config": "4.3.0",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^12.1.5",
		"@types/jest": "^30.0.0",
		"@types/react": "17.0.45",
		"@types/react-dom": "17.0.17",
		"@types/webpack-env": "~1.15.2",
		"@typescript-eslint/parser": "8.31.1",
		"ajv": "^6.12.5",
		"dotenv": "^17.2.0",
		"eslint": "8.57.1",
		"eslint-plugin-react-hooks": "4.3.0",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.0.4",
		"jest-environment-jsdom": "^30.0.4",
		"playwright": "^1.54.1",
		"ts-jest": "^29.4.0",
		"typescript": "~5.3.3"
	},
	"overrides": {
		"@rushstack/heft": "0.74.3",
		"semver": "^7.6.0",
		"got": "^11.8.5",
		"tmp": "^0.2.3",
		"validator": "^13.12.0"
	},
	"resolutions": {
		"@types/react": "17.0.45"
	}
}
